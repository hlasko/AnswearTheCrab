DATABASE_URL=postgres://localhost/atp

# DataForSEO (https://app.dataforseo.com/api-access).
# When unset the app falls back to the free public Google suggest endpoint.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Sandbox: https://sandbox.dataforseo.com
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# Sourcing strategy:
#   labs         - 1 request per search, metrics included (default, cheapest)
#   autocomplete - ~58 requests per search, mirrors Google's search box
DATAFORSEO_MODE=labs
# Labs result cap (max 1000).
DATAFORSEO_LIMIT=700

# --- autocomplete mode only ---
# Autocomplete client: gws-wiz-serp | chrome | chrome-omni | firefox | safari ...
DATAFORSEO_CLIENT=gws-wiz-serp
# Enrich suggestions with Google Ads volume/CPC (extra request per search).
DATAFORSEO_SEARCH_VOLUME=false
DATAFORSEO_CONCURRENCY=8

# OpenRouter, for writing drafts from a brief (https://openrouter.ai/keys).
# Without a key the app still exports the prompt for pasting elsewhere.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
