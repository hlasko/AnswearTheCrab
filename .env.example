DATABASE_URL=postgres://localhost/atp

# DataForSEO (https://app.dataforseo.com/api-access).
# When unset the app falls back to the free public Google suggest endpoint.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Sandbox: https://sandbox.dataforseo.com
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# Autocomplete client: gws-wiz-serp | chrome | chrome-omni | firefox | safari ...
DATAFORSEO_CLIENT=gws-wiz-serp
# Enrich suggestions with Google Ads volume/CPC (extra cost per search).
DATAFORSEO_SEARCH_VOLUME=false
DATAFORSEO_CONCURRENCY=8
